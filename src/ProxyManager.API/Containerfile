FROM mcr.microsoft.com/dotnet/sdk:11.0 AS builder
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_USE_POLLING_FILE_WATCHER=1

WORKDIR /app

# Restore from the project files alone, so the NuGet layer stays cached until a dependency
# changes. List every project in this one's reference graph.
COPY global.json ./
COPY src/ProxyManager.Core/ProxyManager.Core.csproj src/ProxyManager.Core/
COPY src/ProxyManager.Infrastructure/ProxyManager.Infrastructure.csproj src/ProxyManager.Infrastructure/
COPY src/ProxyManager.API/ProxyManager.API.csproj src/ProxyManager.API/
RUN dotnet restore src/ProxyManager.API/ProxyManager.API.csproj

COPY src/ src/

# Build and publish a release. UseAppHost=false: the entrypoint runs `dotnet <dll>`, so the native
# launcher would be dead weight.
RUN dotnet publish src/ProxyManager.API/ProxyManager.API.csproj -c Release -o out --no-restore -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:11.0
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_HTTP_PORTS=8080
WORKDIR /app

COPY --from=builder /app/out .
ENTRYPOINT [ "dotnet", "West94.ProxyManager.API.dll" ]
