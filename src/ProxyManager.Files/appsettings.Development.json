{
  "Database": {
    "ConnectionString": "Host=pod.lab.linux01.west94.io;Port=5432;Database=proxymanager;Username=postgres;Password={{POSTGRES_PASSWORD}}"
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "Bucket": "proxymanager",
    "Region": "us-east-1",
    "AccessKey": "{{RUSTFS_ACCESS_KEY}}",
    "SecretKey": "{{RUSTFS_SECRET_KEY}}",
    "ForcePathStyle": true,
    "AutoCreateBucket": true,
    "PresignedUrlTtl": "00:15:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
