{
  // Production = the Quadlet stack. Other services are addressed by container name (containers on
  // proxymanager.network resolve each other's ContainerName=). Credentials come from Podman secrets as env vars:
  // POSTGRES_PASSWORD (interpolated below), RabbitMQ__UserName/__Password,
  // ObjectStorage__AccessKey/__SecretKey, ServiceToken__SharedSecret.
  "Database": {
    "ConnectionString": "Host=proxymanager-postgresql;Port=5432;Database=proxymanager;Username=proxymanager_admin;Password={{POSTGRES_PASSWORD}}"
  },
  "RabbitMQ": {
    "Host": "proxymanager-rabbitmq",
    "Enabled": true
  },
  "ObjectStorage": {
    "ServiceUrl": "http://proxymanager-rustfs:9000",
    "Bucket": "proxymanager"
  }
}
