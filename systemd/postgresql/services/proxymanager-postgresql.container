[Unit]
Description=Proxy Manager PostgreSQL Database
After=network-online.target
Wants=network-online.target
PartOf=proxymanager.target

[Container]
Environment=POSTGRES_USER=proxymanager_admin
Environment=POSTGRES_DB=proxymanager
Secret=pm-db-pass,type=env,target=POSTGRES_PASSWORD

Image=docker.io/library/postgres:18-alpine
ContainerName=proxymanager-postgresql
Volume=proxymanager-database.volume:/var/lib/postgresql
Network=proxymanager.network
# Published only so local dev runs can use this database (appsettings.Development.json); the
# services reach it as proxymanager-postgresql:5432. See systemd/TODO.md.
PublishPort=5432:5432

ShmSize=128mb

# Health check (runs inside container)
HealthCmd=pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=20s
# Report the unit started only once healthy, so dependents' After= waits for readiness
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=proxymanager.target
