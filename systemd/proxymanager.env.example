# Non-secret, site-specific settings shared by the proxy, API, Files and UI Quadlet units.
#
# Copy to systemd/proxymanager.env (gitignored) and fill in. systemd/proxymanager/deploy.sh
# installs it on the host as ~/proxymanager/proxymanager.env (mode 600), which the units read via
# EnvironmentFile=. Every unit sees every key; each app ignores the ones it doesn't use.
#
# Do NOT put secrets here. Secrets are Podman secrets created by each service's deploy.sh:
#   pm-db-pass                        systemd/postgresql/deploy.sh   (generated)
#   rfs-access-key, rfs-secret-key    systemd/rustfs/deploy.sh       (generated)
#   proxymanager-files-service-token  systemd/files/deploy.sh        (generated)
#   proxymanager-oidc-client-secret   systemd/proxymanager/deploy.sh (issued by Authentik; prompted
#                                     for, or taken from OIDC_CLIENT_SECRET)
#   proxymanager-rabbitmq-user, -password, -conf
#                                     systemd/rabbitmq/deploy.sh     (--username; password generated)
# Service addresses are not set here: the .NET apps take them from appsettings.Production.json and
# the UI from its unit, all by container name. Ports are set in the units.
#
# .NET keys use ASP.NET Core's Section__Key form.
#
# Values are taken literally to the end of the line: don't quote them (quotes become part of the
# value). Spaces and '#' inside a value are fine; only a '#' at the start of a line is a comment.

# Proxy: Authentik OIDC client id (Authentication:ClientId).
Authentication__ClientId=

# API and Files: JWT audience they validate (Authentication:Audience).
Authentication__Audience=

# Proxy: ACME (Let's Encrypt) account contact.
LettuceEncrypt__EmailAddress=

# Proxy: management host, only if it differs from appsettings.json (proxy-manager.west94.io).
# Management__Hosts__0=

# UI: Authentik's self-service account page for the "Edit Profile"/"Change Password" menu items.
# Comment out to disable those items; an empty value counts as set and renders blank links.
AUTHENTIK_ACCOUNT_URL=https://auth.west94.io/if/user/#/settings

# UI: Authentik group whose members get admin rights in the UI (matched against X-Auth-Groups).
# Unset, the UI falls back to "proxy-admins".
ADMIN_GROUP_CLAIM=authentik Admins
