[Unit]
Description=Proxy Manager RustFS Container
After=network-online.target
Wants=network-online.target
PartOf=proxymanager.target

[Container]
Environment=RUSTFS_ADDRESS=:9000
Environment=RUSTFS_VOLUMES=/data
Environment=RUSTFS_CONSOLE_ENABLE=true
Secret=rfs-access-key,type=env,target=RUSTFS_ACCESS_KEY
Secret=rfs-secret-key,type=env,target=RUSTFS_SECRET_KEY

# Pinned so a restart can't pull a different release; bump deliberately. 1.0.5 ships curl and
# /health, which the healthcheck below relies on.
Image=docker.io/rustfs/rustfs:1.0.5
ContainerName=proxymanager-rustfs
Network=proxymanager.network
# Published only for local dev runs (S3 API) and the console; Files reaches it as
# proxymanager-rustfs:9000. See systemd/TODO.md.
PublishPort=9000:9000
PublishPort=9001:9001
Volume=%h/proxymanager-rustfs/data:/data:U,z,rw

HealthCmd=curl -fsS -o /dev/null http://localhost:9000/health
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s
# Report the unit started only once healthy, so dependents' After= waits for readiness
Notify=healthy

[Service]
ExecStartPre=mkdir -p %h/proxymanager-rustfs/data
Restart=always
RestartSec=10sec
TimeoutStartSec=900

[Install]
WantedBy=proxymanager.target
